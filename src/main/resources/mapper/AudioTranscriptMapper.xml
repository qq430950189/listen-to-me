<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.github.listen_to_me.mapper.AudioTranscriptMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.github.listen_to_me.domain.entity.AudioTranscript">
        <id column="id" property="id" />
        <result column="audio_id" property="audioId" />
        <result column="full_text" property="fullText" />
        <result column="segment_json" property="segmentJson" />
